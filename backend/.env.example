# OPNsense API Configuration
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_API_KEY=your-api-key-here
OPNSENSE_API_SECRET=your-api-secret-here
OPNSENSE_VERIFY_SSL=false

# SSH Configuration (for live traffic statistics via ipfw pipe show)
# If not configured, live bandwidth stats won't be available
OPNSENSE_SSH_HOST=192.168.1.1
OPNSENSE_SSH_PORT=22
OPNSENSE_SSH_USER=root
OPNSENSE_SSH_PASSWORD=your-ssh-password-here
